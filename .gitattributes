# Normalize text to LF in the repository and working tree.
* text=auto eol=lf

# Windows batch files break with LF endings.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never diff or normalize.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.wav binary
*.mp3 binary
*.ttf binary
*.woff2 binary
*.zip binary
*.exe binary
*.dll binary
