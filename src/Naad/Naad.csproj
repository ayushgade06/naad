<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A tray app: no console window. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Naad</RootNamespace>
    <!-- WinForms provides the message loop the keyboard hook needs and the STA clipboard. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Original artwork (teal square, white sound-wave bars), MIT like the rest of Naad. -->
    <ApplicationIcon>Assets\naad.ico</ApplicationIcon>
    <!-- The MVP milestone; see CHANGELOG.md. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Types are internal by default (docs/STYLE.md); tests still need to reach them. -->
    <InternalsVisibleTo Include="Naad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\naad.ico" LogicalName="Naad.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Whisper.net.Runtime.Vulkan copies its Linux build (59 MB) into every output, whatever the
       target; Naad runs only on Windows. -->
  <Target Name="DropLinuxVulkanRuntime" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/vulkan/linux-x64/'))" />
    </ItemGroup>
  </Target>

</Project>
