<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A tray app: no console window. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Naad</RootNamespace>
    <!-- WinForms provides the message loop the keyboard hook needs and the STA clipboard. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Original artwork (teal square, white sound-wave bars), MIT like the rest of Naad. -->
    <ApplicationIcon>Assets\naad.ico</ApplicationIcon>
    <!-- For builds from source; a release takes its version from the tag. See CHANGELOG.md. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Types are internal by default (docs/STYLE.md); tests still need to reach them. -->
    <InternalsVisibleTo Include="Naad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\naad.ico" LogicalName="Naad.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.30.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Without a runtime identifier (builds and tests; a release publishes for win-x64), the
       runtime packages copy every platform's natives, about 250 MB. Naad runs only on 64-bit
       Windows: Whisper.net's come in as None items, LLamaSharp's as Content items. -->
  <Target Name="DropOtherPlatformRuntimes" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/vulkan/linux-x64/'))
                       Or $([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-x86/'))
                       Or $([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-arm64/'))" />
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Identity)').Contains('LLamaSharpRuntimes\linux-'))
                          Or $([System.String]::Copy('%(Content.Identity)').Contains('LLamaSharpRuntimes\osx-'))
                          Or $([System.String]::Copy('%(Content.Identity)').Contains('LLamaSharpRuntimes\win-arm64'))" />
    </ItemGroup>
  </Target>

</Project>
